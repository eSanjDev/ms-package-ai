{
    "name": "esanj/ai-client",
    "description": "Laravel client package for the Esanj AI Microservice (workflows & executions)",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Esanj",
            "email": "esanjdev@gmail.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "ext-json": "*",
        "esanj/auth-bridge": "^1.0",
        "illuminate/support": "^12.0|^13.0",
        "illuminate/log": "^12.0|^13.0",
        "guzzlehttp/guzzle": "^7.8|^8.0",
        "psr/log": "^1.0|^2.0|^3.0"
    },
    "autoload": {
        "psr-4": {
            "Esanj\\AiClient\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Esanj\\AiClient\\AiClientServiceProvider"
            ],
            "aliases": {
                "Ai": "Esanj\\AiClient\\Facades\\Ai"
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
